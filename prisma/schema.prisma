generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  WORKER
  ADMIN
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  email           String   @unique
  phone           String
  passwordHash    String   @map("password_hash")
  role            Role     @default(USER)
  // Dados básicos do veículo: { marca, modelo, ano, placa, cor }
  cadastroVeiculo Json?    @map("cadastro_veiculo")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  worker    Worker?
  historico Historico[]

  @@map("users")
}

// Histórico de pedidos de assistência
model Historico {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  serviceTypeId String   @map("service_type_id") @db.Uuid
  servico       String
  preco         Int
  veiculo       String
  endereco      String
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("historico")
}

model Worker {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @unique @map("user_id") @db.Uuid
  name      String
  categoria String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workers")
}

model ServiceType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String
  icon        String
  basePrice   Int      @map("base_price")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_types")
}
